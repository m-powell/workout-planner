# Path to the SQLite database file.
# For local `npm run dev`, use ./data/gym.db. In Docker this must stay /app/data/gym.db
# to match the docker-compose bind mount (./data on the host -> /app/data in the container).
DATABASE_PATH=/app/data/gym.db

# Optional simple PIN gate (leave blank to disable)
APP_PIN=

# Only needed if you put a reverse proxy in front of this app with a different host/port
# than what the app itself sees. Plain Tailscale access (http://<tailscale-name>:3000)
# does not need this set.
# ORIGIN=http://localhost:3000
